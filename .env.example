# 복사해서 .env 로 사용하세요 (실제 키는 커밋 금지)

# 백엔드 API 베이스 URL (개발 서버에서는 Vite 프록시 사용)
# 실제 API(https://api.salpim.me)는 개발·배포 프록시를 통해 연결합니다.
VITE_API_BASE_URL=/api

# 카카오 OAuth 2.0 (developers.kakao.com > 내 애플리케이션)
# REST API 키
VITE_KAKAO_REST_API_KEY=your_kakao_rest_api_key
# 카카오 개발자 콘솔에 등록한 Redirect URI 와 반드시 일치
VITE_KAKAO_REDIRECT_URI=http://localhost:5173/oauth/kakao

# 카카오맵 JavaScript SDK 키 (developers.kakao.com > 내 애플리케이션 > 앱 키 > JavaScript 키)
# 플랫폼 > Web 에 http://localhost:5173 등록 필요
VITE_KAKAO_MAP_KEY=your_kakao_javascript_key
